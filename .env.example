# Copy to .env and adjust. NEVER commit .env.

# development | staging | production
# Setting this to "production" turns on startup checks that refuse to run with
# development defaults — see _refuse_unsafe_production_config in core/config.py.
ENV=development

DATABASE_URL=postgresql+psycopg://tbscreen:tbscreen_dev@localhost:5432/tbscreenai

# At least 32 characters in production, and not this value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# "*" is accepted in development only; production requires explicit origins,
# e.g. ["https://admin.tbscreen.example.id"]
CORS_ORIGINS=["*"]

# Upload ceiling for /diagnoses/infer. 25 MB covers a full-resolution DICOM
# study while bounding what a single request can make the server hold.
MAX_UPLOAD_BYTES=26214400

# Login attempts per client IP per window. Counted per process, so N workers
# means N times this budget until a shared store is introduced.
LOGIN_RATE_LIMIT=10/minute
