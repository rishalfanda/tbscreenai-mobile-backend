# Copy to .env and adjust. NEVER commit .env.

# development | staging | production
# Setting this to "production" turns on startup checks that refuse to run with
# development defaults — see _refuse_unsafe_production_config in core/config.py.
ENV=development

DATABASE_URL=postgresql+psycopg://tbscreen:tbscreen_dev@localhost:5432/tbscreenai

# At least 32 characters in production, and not this value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# "*" is accepted in development only; production requires explicit origins,
# e.g. ["https://admin.tbscreen.example.id"]
CORS_ORIGINS=["*"]

# Upload ceiling for /diagnoses/infer. 25 MB covers a full-resolution DICOM
# study while bounding what a single request can make the server hold.
MAX_UPLOAD_BYTES=26214400

# Object storage. These defaults match the MinIO service in docker-compose.yml.
# Production refuses the development credentials — see core/config.py.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=tbscreen
STORAGE_SECRET_KEY=tbscreen_dev_storage
STORAGE_BUCKET=tbscreen-images

# boto3 will not build a client without a region even when the endpoint is not
# AWS. MinIO ignores the value.
STORAGE_REGION=us-east-1

# The app creates its own bucket at startup so a fresh `docker compose up`
# needs no manual step. Set false in any deployment: there the bucket is
# provisioned by whoever also sets its retention and encryption policy, and the
# app has no business holding CreateBucket rights.
STORAGE_AUTO_CREATE_BUCKET=true

# Chest X-rays cross this link. Production refuses a plaintext http:// endpoint
# unless this is set — which makes storage on a closed private network a
# decision on the record rather than something nobody looked at.
STORAGE_ALLOW_INSECURE_ENDPOINT=false

# Server-side encryption header sent with every object. Left empty in
# development because MinIO needs a key service configured before it will
# honour it. Set to AES256 once that exists.
STORAGE_SERVER_SIDE_ENCRYPTION=

# Login attempts per client IP per window. Counted per process, so N workers
# means N times this budget until a shared store is introduced.
LOGIN_RATE_LIMIT=10/minute
